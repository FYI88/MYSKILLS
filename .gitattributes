# Shell scripts must use LF endings or they break on Linux/macOS
*.sh text eol=lf
*.bash text eol=lf

# PowerShell works with either, but LF is safer across editors
*.ps1 text eol=lf

# Python and markdown
*.py text eol=lf
*.md text eol=lf

# YAML config
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
